# =========================================================
# BizMind AI — Environment Variables Template (.env.example)
# Copy this file to .env and fill in your real values.
# NEVER commit .env or any real secret keys to Git!
# =========================================================

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=https://bizmind-ai-orcin.vercel.app

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/bizmind_ai?schema=public"

# Authentication & Security (Generate strong 64-char random hex secrets)
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_SECRET"
REFRESH_TOKEN_SECRET="REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_SECRET"
API_KEY_SALT="REPLACE_WITH_API_KEY_SALT"
COOKIE_SECURE=true

# Demo Mode Control (Set to false on strict production deploys if Demo runs on a separate subdomain)
DEMO_MODE=true

# Live AI (Google Gemini 2.5 Flash + Google Search Grounding)
GEMINI_API_KEY="REPLACE_WITH_YOUR_GEMINI_API_KEY"

# Isolated Super Admin Console (No public signup; seed via scripts/seed-super-admin.ts)
ADMIN_SEED_EMAIL="admin@yourdomain.com"
ADMIN_SEED_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD"
ADMIN_TOTP_SECRET="REPLACE_WITH_BASE32_TOTP_SECRET"

# Error Monitoring (Optional — Sentry DSN)
SENTRY_DSN=""

# Notifications / Automation (Optional)
TELEGRAM_BOT_TOKEN=""
N8N_WEBHOOK_URL=""
